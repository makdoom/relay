{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["./base.json"],
  "linter": {
    "rules": {
      "nursery": {
        "useTailwindSortedClasses": "off"
      },
      "correctness": {
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
