{
  "name": "relay",
  "version": "1.0.0",
  "private": "true",
  "description": "Relay — Production-minded Real-Time Messaging Platform Monorepo",
  "scripts": {
    "dev:api": "pnpm --filter @relay/api dev",
    "build:api": "pnpm --filter @relay/api build",
    "start:api": "pnpm --filter @relay/api start",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:status": "docker compose ps",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @relay/api db:generate",
    "db:migrate": "pnpm --filter @relay/api db:migrate",
    "db:studio": "pnpm --filter @relay/api db:studio",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
