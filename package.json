{
  "name": "relay",
  "version": "1.0.0",
  "private": "true",
  "description": "Relay — Production-minded Real-Time Messaging Platform Monorepo",
  "scripts": {
    "dev:api": "pnpm --filter @relay/api dev",
    "build:api": "pnpm --filter @relay/api build",
    "start:api": "pnpm --filter @relay/api start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
